<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- Pinned Header with Back Button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Faculty Record"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Scrollable Form Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Faculty ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faculty ID:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etFacultyId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Faculty ID (e.g. F101)"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <!-- Faculty Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faculty Name:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etFacultyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Faculty Name"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp" />

            <!-- Department -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Department:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etFacultyDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Department (e.g. CS)"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etFacultyEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Email Address"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="12dp" />

            <!-- Phone Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etFacultyPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Phone Number"
                android:inputType="phone"
                android:layout_marginBottom="20dp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSaveFaculty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Faculty Info"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnClearFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
