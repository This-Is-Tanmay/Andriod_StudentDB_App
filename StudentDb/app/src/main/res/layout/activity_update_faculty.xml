<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- Pinned Header with Back Button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Update Faculty Info"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Scrollable Form Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Faculty ID to search -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faculty ID (to update):"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etUpdateFacultyId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Faculty ID"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <!-- New Faculty Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Faculty Name:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etUpdateFacultyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter New Name"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp" />

            <!-- New Department -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Department:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etUpdateFacultyDept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter New Department"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <!-- New Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Email:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etUpdateFacultyEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter New Email"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="12dp" />

            <!-- New Phone Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Phone Number:"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etUpdateFacultyPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter New Phone"
                android:inputType="phone"
                android:layout_marginBottom="20dp" />

            <!-- Update Button -->
            <Button
                android:id="@+id/btnUpdateFacultySubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UPDATE FACULTY INFO" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
